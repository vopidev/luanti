#!/bin/bash

# Pre-commit hook for the luanti submodule.
#
# Precise leak guard: the commit is rejected only if the STAGED content
# still contains applied VOPI Engine patches (or a bad guard spelling).
# Unstaged worktree state - including applied patches - no longer blocks
# commits, so unrelated WIP does not get in the way. Reverting patches is
# only required when committing the patch-managed files themselves.

TOPLEVEL="$(git rev-parse --show-toplevel)"
PATCHES_DIR="$TOPLEVEL/../patches/luanti"

echo "🔍 Checking staged content for applied VOPI patches..."

fail=0

if [ -d "$PATCHES_DIR" ]; then
    for patch in "$PATCHES_DIR"/*.patch; do
        [ -f "$patch" ] || continue
        # If the patch reverse-applies cleanly against the index, the
        # staged tree contains the applied patch content and this commit
        # would leak it into the public repo.
        if git apply --cached --reverse --check "$patch" 2>/dev/null; then
            echo "❌ Staged changes contain the applied patch: $(basename "$patch")"
            fail=1
        fi
    done
fi

# Guard discipline: an ifdef/ifndef test of IS_VOPI_ENGINE silently
# matches the =0 build; the tree uses value tests ('#if') everywhere.
if git diff --cached | grep -qE '^\+.*#[[:space:]]*(ifdef|ifndef)[[:space:]]+IS_VOPI_ENGINE'; then
    git diff --cached | grep -nE '^\+.*#[[:space:]]*(ifdef|ifndef)[[:space:]]+IS_VOPI_ENGINE'
    echo "❌ Use '#if IS_VOPI_ENGINE' / '#if !IS_VOPI_ENGINE', not #ifdef/#ifndef."
    fail=1
fi

if [ $fail -ne 0 ]; then
    echo ""
    echo "To commit a patch-managed file legitimately, revert the patches first:"
    echo "  (cd .. && ./scripts/revert_luanti_patches.sh)"
    exit 1
fi

echo "✅ Staged content clean, proceeding with commit..."
exit 0
